INNER JOIN (
    SELECT [p0].[Id], [p0].[ChannelAccountId], [p0].[CreatedAt], [p0].[CreatedBy], [p0].[DayNumber], [p0].[ExternalPostId], [p0].[IsDeleted], [p0].[ProjectId], [p0].[PublishedAt], [p0].[PublishedUrl], [p0].[ScheduledAt], [p0].[Status], [p0].[TimelineId], [p0].[Title], [p0].[TrackingEnabled], [p0].[UpdatedAt], [p0].[UpdatedBy], [p0].[VoiceSampleId]
    FROM [Posts] AS [p0]
    WHERE [p0].[IsDeleted] = CAST(0 AS bit)
) AS [t] ON [p].[PostId] = [t].[Id]
LEFT JOIN (
    SELECT [p1].[Id], [p1].[Content], [p1].[ContentType], [p1].[CreatedAt], [p1].[CreatedBy], [p1].[IsDeleted], [p1].[MediaFileId], [p1].[PostId], [p1].[SortOrder], [p1].[UpdatedAt], [p1].[UpdatedBy]
    FROM [PostContents] AS [p1]
    WHERE [p1].[IsDeleted] = CAST(0 AS bit)
) AS [t0] ON [t].[Id] = [t0].[PostId]
WHERE [p].[IsDeleted] = CAST(0 AS bit) AND [p].[Status] = 0 AND [p].[ScheduledAt] <= @__before_0
ORDER BY [p].[ScheduledAt], [p].[Id], [t].[Id]
